{
  "name": "gunchained",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "npm run build --prefix picker && NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "build": "yarn theme:build && NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "theme:build": "npm ci --prefix picker && npm run build --prefix picker",
    "test:unit": "vue-cli-service test:unit",
    "lint": "vue-cli-service lint",
    "media:capture": "node scripts/capture-media.mjs"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "core-js": "^3.6.5",
    "dayjs": "^1.8",
    "firebase": "^7.12.0",
    "firebaseui": "^4.6.1",
    "rss": "^1.2.2",
    "vue": "^2.6.11",
    "vue-gtag": "^1.9.1",
    "vue-head": "^2.2.0",
    "vue-router": "^3.2.0",
    "vuefire": "^2.2.2",
    "vuetify": "^2.2.11",
    "vuex": "^3.4.0",
    "vuexfire": "^3.2.4"
  },
  "devDependencies": {
    "@soleone/showcase": "0.2.0",
    "@vue/cli-plugin-babel": "~4.5.0",
    "@vue/cli-plugin-eslint": "~4.5.0",
    "@vue/cli-plugin-router": "~4.5.0",
    "@vue/cli-plugin-unit-mocha": "~4.5.0",
    "@vue/cli-plugin-vuex": "~4.5.0",
    "@vue/cli-service": "~4.5.0",
    "@vue/eslint-config-prettier": "^6.0.0",
    "@vue/test-utils": "^1.0.3",
    "babel-eslint": "^10.1.0",
    "chai": "^4.1.2",
    "eslint": "^6.7.2",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-vue": "^6.2.2",
    "prettier": "^1.19.1",
    "sass": "^1.19.0",
    "sass-loader": "^8.0.2",
    "vue-cli-plugin-vuefire": "^1.0.2",
    "vue-cli-plugin-vuetify": "^2.0.7",
    "vue-template-compiler": "^2.6.11",
    "vuetify-loader": "^1.3.0"
  },
  "engines": {
    "node": "22.x"
  }
